@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquerymin.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/utilitiesjs/commonmethod.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/loginjs/dashboard.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<link href="~/css/login/dashboardalert.css" nonce="5d67de6751aa4e158c33dfd828fc144b" rel="stylesheet" />


<div style="text-align:center;padding-top: 8%;font-size: 15px;">
   
    <img src="~/images/loginlogo.png" />
    <h1 style="padding-top: 10px;color:#c2b6b4;font-family:'Times New Roman', Times, serif;">Asirvad</h1>
    <h1 style="color:#c2b6b4;font-family:'Times New Roman', Times, serif;">Gold Loan Legal Corporate</h1>
</div>
<!-- Modal Backdrop -->
<div class="modal-backdrop" id="modalBackdrop"></div>

<!-- Pending Alerts Modal -->
<div class="modal pending-alerts-modal" id="pendingAlertsModal" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h4 class="modal-title">
                    <i class="fas fa-bell shake"></i> Pending Alerts
                </h4>
                
            </div>

            <!-- Body -->
            <div class="modal-body">
                <div id="alertsContainer">
                    <div class="employee-name text-center mb-3" style="font-weight:600; color:#d35400;"></div>
                   <br> <ul id="pendingAlertsList" class="alerts-list"></ul>
                </div>
                <div class="no-alerts text-center py-4" style="display:none; color:#7f8c8d;">
                    <i class="fas fa-check-circle" style="font-size:2.5rem; color:#27ae60;"></i>
                    <p class="mt-3 mb-0">No pending alerts!</p>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-ok">
                    <i class="fas fa-thumbs-up"></i> OK
                </button>
            </div>

        </div>
    </div>
</div>