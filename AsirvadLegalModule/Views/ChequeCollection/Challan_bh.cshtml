                            </div>
                            <div class="form-group">
                                <label for="txt_chal_dt" class="form-label">Challan Date</label>
                                <input type="date" id="txt_chal_dt" name="txt_chal_dt" class="form-control"@*  onchange="Challan_bh.validateChallanDate1(this.value)"  *@/>
