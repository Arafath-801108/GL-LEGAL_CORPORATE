                            </div>
                        </div>

                        <div class="section-row">
                            <div class="form-group">
                                <label for="txt_zone" class="form-label">Zone Name</label>
                                <input type="text" id="txt_zone" name="txt_zone" class="form-control" disabled />
                            </div>
                            <div class="form-group">
                                <label for="txt_amt" class="form-label">Staff Debit Amount</label>
                                <input type="text" id="txt_amt" name="txt_amt" class="form-control" disabled />
                            </div>
                        </div>

                        <div class="section-row">
                            <div class="form-group">
