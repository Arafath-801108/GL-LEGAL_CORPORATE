                                <input type="text" id="Text12" name="Text12" class="form-control" disabled />
                            </div>
                            <div class="form-group">
                                <label for="Text13" class="form-label">Branch Name</label>
                                <input type="text" id="Text13" name="Text13" class="form-control" disabled />
                            </div>
                        </div>

                        <div class="section-row">
                            <div class="form-group">
                                <label for="Text14" class="form-label">Area Name</label>
                                <input type="text" id="Text14" name="Text14" class="form-control" disabled />
                            </div>
                            <div class="form-group">
                                <label for="Text15" class="form-label">Region Name</label>
                                <input type="text" id="Text15" name="Text15" class="form-control" disabled />
                            </div>
                        </div>

                        <div class="section-row">
                            <div class="form-group">
                                <label for="Text16" class="form-label">Zone</label>
                                <input type="text" id="Text16" name="Text16" class="form-control" disabled />
                            </div>
                            <div class="form-group">
                                <label for="Text17" class="form-label">Challan Date</label>
                            <input type="date" id="Text17" name="Text17" class="form-control" @* onchange="Challan_bh.validateChallanDate()" *@ />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="address" class="form-label">Address</label>
                            <textarea id="address" name="address" class="form-control" disabled rows="3"></textarea>
                        </div>

                        <div class="document-section">
                            <div class="document-row">
                                <h6 class="document-label">Cheque Document:</h6>
                            <button type="button" id="imgview" class="btn view-btn" @* onclick="Challan_bh.pdfdownload(this.value)" *@>VIEW</button>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="FileUpload1" class="form-label">Challan/Receipt Upload</label>
                            <input type="file" id="FileUpload1" name="FileUpload1" class="form-control file-upload" accept="application/pdf" />
                        </div>

                        <div class="form-group">
                            <label for="remarks" class="form-label">Remark</label>
                            <textarea id="remarks" name="remarks" class="form-control" maxlength="100" @* oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '');" onkeyup="checkLength(this, 150);" *@></textarea>
                        </div>

                        <div class="button-row">
                        <button type="button" id="btnconfirm1" class="btn primary-btn" @* onclick="Challan_bh.sumbitPledgeDetails(this.value);" *@>CONFIRM</button>
                        <button type="button" id="btnexit1" class="btn secondary-btn"  @* onclick="redirectToDashboard()" *@>EXIT</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script nonce="5d67de6751aa4e158c33dfd828fc144b">
      

        function validateirrgularity() {
            const irregularityType = document.getElementById("drp_irr").value;
            const employeeDiv = document.getElementById("employee_div");
            const customerDiv = document.getElementById("customer_div");

            if (irregularityType === "4") { // Employee Debit
                employeeDiv.style.display = "block";
                customerDiv.style.display = "none";
            } else if (irregularityType !== "0") { // Other options except SELECT
                employeeDiv.style.display = "none";
                customerDiv.style.display = "block";
            } else { // SELECT option
                employeeDiv.style.display = "none";
                customerDiv.style.display = "none";
            }
        }

        function convertDateFormat(inputDate) {
            var parts = inputDate.split('-');
            var day = parts[0];
            var month = parts[1];
            var year = parts[2];
            var monthNames = {
                'JAN': '01', 'FEB': '02', 'MAR': '03', 'APR': '04',
                'MAY': '05', 'JUN': '06', 'JUL': '07', 'AUG': '08',
                'SEP': '09', 'OCT': '10', 'NOV': '11', 'DEC': '12'
            };
            var monthNumber = monthNames[month.toUpperCase()];
            var formattedDate = year + '-' + monthNumber + '-' + (day.length === 1 ? '0' + day : day);
            return formattedDate;
        }

        function validateChallanDate() {
            var createdDate = document.getElementById('createdDate').value;
            var challanDate = document.getElementById('Text17').value;
            var currentDate = new Date().toISOString().split('T')[0];

            if (createdDate.includes('-')) {
                createdDate = convertDateFormat(createdDate);
            }
            if (challanDate < createdDate || challanDate > currentDate) {
                AlertM1('Challan Date must be between the Reported Date and the Current Date');
                document.getElementById('Text17').value = '';
            }
        }

        function validateChallanDate1() {
            var resignedDate = document.getElementById('txt_redt').value;
            var challanDate = document.getElementById('txt_chal_dt').value;
            var currentDate = new Date().toISOString().split('T')[0];

            if (resignedDate.includes('-')) {
                resignedDate = convertDateFormat(resignedDate);
            }
            if (challanDate < resignedDate || challanDate > currentDate) {
                AlertM1('Challan Date must be between the Last working Date and the Current Date');
                document.getElementById('txt_chal_dt').value = '';
            }
        }

        function validateInput() {
            if (document.getElementById("drp_irr").value === "0") {
                AlertM1("Please select irregularity type..!!");
                document.getElementById("drp_irr").focus();
                return false;
            }
            if (document.getElementById("DropDownList2").value === "-1") {
                AlertM1("Please select pledge..!!");
                document.getElementById("DropDownList2").focus();
                return false;
            }
            if (document.getElementById("Text17").value == "") {
                AlertM1("Please select challan date..!!");
                document.getElementById("Text17").focus();
                return false;
            }
            if (document.getElementById('FileUpload1').value === "") {
                AlertM1("Please attach challan document..!!");
                document.getElementById('FileUpload1').focus();
                return false;
            }
            var fp = document.getElementById("FileUpload1").value;
            var fileExtension = fp.trim().toLowerCase().split('.').pop();
            if (fileExtension !== "pdf") {
                AlertM1("Only PDF files are allowed for uploading.");
                document.getElementById("FileUpload1").value = "";
                return false;
            }
            if (document.getElementById("remarks").value == "") {
                AlertM1("Please enter remark..!!");
                document.getElementById("remarks").focus();
                return false;
            }
        }

        function validateInput1() {
            if (document.getElementById("drp_irr").value === "0") {
                AlertM1("Please select irregularity type..!!");
                document.getElementById("drp_irr").focus();
                return false;
            }
            if (document.getElementById("drp_pledge").value === "-1") {
                AlertM1("Please select employee..!!");
                document.getElementById("drp_pledge").focus();
                return false;
            }
            if (document.getElementById("txt_chal_dt").value == "") {
                AlertM1("Please select challan date..!!");
                document.getElementById("txt_chal_dt").focus();
                return false;
            }
            if (document.getElementById('FileUpload2').value === "") {
                AlertM1("Please attach challan document..!!");
                document.getElementById('FileUpload2').focus();
                return false;
            }
            var fp = document.getElementById("FileUpload2").value;
            var fileExtension = fp.trim().toLowerCase().split('.').pop();
            if (fileExtension !== "pdf") {
                AlertM1("Only PDF files are allowed for uploading.");
                document.getElementById("FileUpload2").value = "";
                return false;
            }
            if (document.getElementById("txt_remark1").value == "") {
                AlertM1("Please enter remark..!!");
                document.getElementById("txt_remark1").focus();
                return false;
            }
        }

        function checkLength(textBox, maxLength) {
            if (textBox.value.length > maxLength) {
                textBox.value = textBox.value.substring(0, maxLength);
            }
        }
    </script>
@* </div> *@
