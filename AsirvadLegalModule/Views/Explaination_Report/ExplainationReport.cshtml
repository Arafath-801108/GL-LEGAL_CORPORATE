@{
    ViewData["Title"] = "Irregularity Report";
}

<link rel="stylesheet" href="~/css/ExplainationModule/ExplStyle.css" />

<div class="report-container">
    <h2>Irregularity Report</h2>

    <form id="reportForm" class="report-form">
        <div class="form-group">
            <label for="fromDate">From Date</label>
            <input type="date" id="fromDate" name="fromDate" required />
        </div>

        <div class="form-group">
            <label for="toDate">To Date</label>
            <input type="date" id="toDate" name="toDate" required />
        </div>

        <button type="submit" class="btn-primary">Generate Report</button>
    </form>

    <div id="reportResults" class="report-results">
        <!-- Results will be injected here -->
    </div>
</div>

<script src="~/js/ExplainationUpdation/ExplReport.js"></script>
