@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 <link href="~/css/irregularityreccall/irregularityrecoveryrpt.css" rel="stylesheet" />
<script src="~/js/jquerymin.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/popper.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/lib/sweet-alert/sweet-alert2.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/lib/aes/4.2.0-crypto-js.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/lib/aes/aes.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/irregularityreccall/irregularitycallrpt.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/alertutils.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/utilitiesjs/commonmethod.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/legalnotice/xlsx.full.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/legalnotice/jquery.datatables.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Recovery Call Report</h3>
        </div>
        <div class="card-body">
            <div class="section-row">
                <div class="form-group">
                    <label for="fmDate" class="form-label">From Date:</label>
                    <input type="date" id="fmDate" name="fmDate" class="form-control" placeholder="Select start date" @* onchange="validateDates();"  *@/>
                </div>
                <div class="form-group">
                    <label for="toDate" class="form-label">To Date:</label>
                    <input type="date" id="toDate" name="toDate" class="form-control" placeholder="Select end date"@*  onchange="validateDates();"  *@/>
                </div>
            </div>
            <div class="text-center mt-5">
                <button id="generateReport" class="btn btn-primary" @* onclick="_Report.IrregularityCallDetails();" *@>Generate Report</button>
                <button id="excelReport" class="btn btn-primary1" @* onclick="_Report.excelconvertreport();" *@ >Excel</button>

                <button id="exitButton" class="btn btn-secondary" @* onclick="redirectToDashboard();" *@>Exit</button>
            </div>
            <div id="div_rpt" style="display:none;">
                <h5 class="section-title">Report Results</h5>
                <div class="report-table-container">
                    <table id="dataTable1" class="report-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Zonal Name</th>
                                <th>Area Name</th>
                                <th>Branch Id</th>
                                <th>Customer Id</th>
                                <th>Customer Name</th>
                                <th>Pledge Number</th>
                                <th>Loss Amount</th>
                                <th>First Call Date</th>
                                <th>First Customer Remark</th>
                                <th>Second Call Date</th>
                                <th>Second Customer Remark</th>
                                <th>Home Visit</th>
                                <th>Home Visit Remark</th>
                                <th>Customer Response</th>
                                <th>Pledge Status</th>
                                <th>Document1</th>
                                <th>Document2</th>
                            </tr>
                        </thead>
                        <tbody id="reportTable"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>