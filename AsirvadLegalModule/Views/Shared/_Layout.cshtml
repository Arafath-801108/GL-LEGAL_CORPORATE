    <script nonce="5d67de6751aa4e158c33dfd828fc144b">
        $(document).ready(async function() {
           
            if (!sessionStorage.getItem("EmployeeId") || !sessionStorage.getItem("BranchId") || !sessionStorage.getItem("Token") || !sessionStorage.getItem("Post") || !sessionStorage.getItem("employeeName")) {
                const isDevelopment = window.location.hostname === 'localhost';
                const liveurl = isDevelopment ? '' : '/AsirvadGoldloan/LegalCorporate';
                await showAlert("Alert!", "Session Expired..Please try again..", "warning");
                return window.location.href = liveurl + '/Login';
            }
            const employeeName = decryptAES(sessionStorage.getItem("employeeName"));
            if (employeeName) {
                $('#span_name').text(employeeName);

            } else {
                $('#span_name').text("0");
            }

            
            // Handle browser navigation
           


            $('#profileToggle').on('click', function (e) {
                e.stopPropagation();
                $('.profile-dropdown').toggleClass('show');
            });

            // Close dropdown when clicking outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.profile-section').length) {
                    $('.profile-dropdown').removeClass('show');
                }
            });
            // Sidebar toggle - update this function
            $('#sidebarCollapse').on('click', function (e) {
                e.preventDefault(); // Prevent any default action
                $('#sidebar').toggleClass('active');
                $('#content').toggleClass('active');
            });

            // Submenu toggle
            $('.has-submenu > .nav-link').on('click', function (e) {
                e.preventDefault();
                const $parent = $(this).parent();
                $parent.toggleClass('open');
                $parent.find('.submenu').slideToggle(300);
            });

            // Remove or modify the checkWidth function
            // Instead of automatically toggling based on width, let the user control it
            function initialCheckWidth() {
                if ($(window).width() <= 768) {
                    // On initial load for small screens, collapse sidebar
                    $('#sidebar').addClass('active');
                    $('#content').addClass('active');
                }
            }

            // Only run once on page load
            initialCheckWidth();
            
            

        });
    </script>
