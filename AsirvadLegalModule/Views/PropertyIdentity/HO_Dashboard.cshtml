<div class="dashboard-wrapper">
    <div class="form-selector">
        <h1><i class="fas fa-chart-line"></i> HO Dashboard</h1>
        <div class="select-wrapper">
            <select id="formSelect">
                <option value="-1">--Select a Form--</option>
                <option value="1">1.HO Assign</option>
                <option value="2">2.List Certificate HO Approve</option>
                <option value="3">3.RTI Acknowledgement Verification</option>
                <option value="4">4.Property Details Approval</option>
            </select>
        </div>
    </div>

    <div class="section" id="section1" style="display:none;">
        <h2>Assign RTI Pending List</h2>
        <div class="section-content">
            <div class="radio-group">
                <label><input type="radio" name="entityType" value="customer">Customer</label>
                <label><input type="radio" name="entityType" value="employee">Employee</label>
            </div>
            <div id="customerFields" style="display: none;">
                <div class="field-row">
                    <div class="field-col">
                        <label for="customerId">Customer ID</label>
                        <input type="text" id="customerId" maxlength="12" autocomplete="off">
                    </div>
                    <div class="field-col">
                        <label for="branchId">Branch ID</label>
                        <input type="text" id="branchId1" maxlength="4" autocomplete="off">
                    </div>
                    <div class="field-col">
                        <label for="ho_rmk">Remark</label>
                        <input type="text" id="ho_rmk" maxlength="50" autocomplete="off">
                    </div>
                    <div class="field-col">
                        <button type="button" id="addButton" style="display:none;">Add</button>
                    </div>

                </div>
            </div>
            <div id="employeeFields" style="display: none;">
                <div class="field-row">
                    <div class="field-col">
                        <label for="employeeId">Employee ID</label>
                        <input type="text" id="employeeId" maxlength="6" autocomplete="off">
                    </div>
                    <div class="field-col">
                        <label for="branchId">Branch ID</label>
                        <input type="text" id="branchId2" maxlength="4" autocomplete="off">
                    </div>
                    <div class="field-col">
                        <label for="ho_rmk2">Remark</label>
                        <input type="text" id="ho_rmk2" maxlength="50" autocomplete="off">
                    </div>
                    <div class="field-col">
                        <button type="button" id="addButton2" style="display:none;">Add</button>
                    </div>
                </div>
            </div>
           
            <div id="gridView">
                <table id ="tab1"class="grid-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Branch ID</th>
                            <th>Remarks</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            
            <div class="button-group">
                <button type="button" id="confirmBtn">Confirm</button>
                <button type="button" id="exitBtn">Exit</button>
            </div>
        </div>
    </div>

