        <h2> List Certificate AH/AM Recommend</h2>
        <div class="section-content">
            <div class="radio-group">
                <label><input type="radio" name="entityType1" value="customer">Customer</label>
                <label><input type="radio" name="entityType1" value="employee">Employee</label>
            </div>
            
            
            <div id="customerFields1" style="display: none;">
                <div class="field-row">
                    <div class="field-col">
                        <label for="branch1">Select Branch</label>
                        <select id="branch1">
                           @*  <option value="-1">--Select Branch--</option> *@
                           
                        </select>
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-col">
                        <label for="selectId1">Customer ID</label>
                        <select id="selectId1">
                            @* <option value="-1">--Select ID--</option> *@
                        </select>
                    </div>
                    <div class="field-col">
                        <label for="cus_name1">Customer Name</label>
                        <input type="text" id="cus_name1" readonly>
                    </div>
                </div>

                <div class="field-row">
                    <div class="field-col">
                        <label for="cus_Branch1">Customer Branch</label>
                        <input type="text" id="cus_Branch1" readonly>
                    </div>
                    <div class="field-col">
                        <label for="cus_phno1">Phone Number</label>
                        <input type="text" id="cus_phno1" readonly>
                    </div>
                </div>

                <div class="field-row">
                    <div class="field-col">
                        <label for="cus_add1">Address</label>
                        <textarea id="cus_add1" readonly></textarea>
                    </div>
                    <div class="field-col">
                        <label for="cus_hormk1">HO Remark</label>
                        <textarea id="cus_hormk1" readonly></textarea>
                    </div>
                </div>
            </div>
            <div id="employeeFields1" style="display: none;">
                <div class="field-row">
                    <div class="field-col">
                        <label for="branch2">Select Branch</label>
