<div class="dashboard-wrapper">
    <div class="form-selector">
        <h1><i class="fas fa-chart-area"></i> AH/AMS Dashboard</h1>
        <div class="select-wrapper">
            <select id="formSelect">
                <option value="-1">--Select a Form--</option>
                <option value="1">1. List Certificate AH/AM Recommend</option>
                <option value="2">2. RTI Acknowledgement Card Recommend</option>
                <option value="3">3. Property Details Recommend</option>
            </select>
        </div>
    </div>

    <!-- Page 1: Upload RTI Application & Challan -->
