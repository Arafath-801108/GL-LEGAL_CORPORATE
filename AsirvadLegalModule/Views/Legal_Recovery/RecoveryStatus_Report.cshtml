<script src="~/js/legalnotice/jspdf.plugin.autotable.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/legalnotice/xlsx.full.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/legalnotice/jquery.datatables.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>


<div class="body">

    <form id="form1" runat="server">
        <div class="container-fluid mt-4" id="fullbody">
            <div class="card text-center">
                <div class="card-header" id="chead">
                     Report
                </div>
                <div class="card-body" style="flex: 1; overflow-y: auto; overflow-x: auto;">
                    <div class="container text-center">
                        <div class="align-items-center">
                            <div class="row">
                                <label for="report_type" class="form-label mb-0">Pledge Number</label>
                            </div>
                            <div class="row">

                                <input class="form-control" id="drp_report" maxlength="16" autocomplete="off"
                                       @* oninput="this.value = this.value.replace(/\D/g, '')" *@ />

                            </div>
                            
                            <div class="row">
                                <button type="button" id="search" class="btn btn-primary" @* onclick="_report.getdtl(this)" *@>Search</button>
                            </div>
                            <button type="button" id="btnexit" class="btn btn-secondary btn-side" @* onclick="redirectToDashboard(this)" *@ title="Export Data">
                                <i class="fas fa-solid fa-left-from-bracket"></i>
                                <span class="button-text">Exit</span>
                            </button>
                        </div>

                        <div id="second_sub" style="display: none">
                            <div class="card-header" id="chead1" style="margin: 2rem 0rem 1.5rem 0rem">
                                Legal Recovery Report
                            </div>
                            <div class="container-fluid mt-4">
                               
                                <button type="button" id="Excel" class="btn btn-secondary btn-side" @* onclick="_report.downloadExcel(this)" *@ title="Export Data">
                                    <i class="fas fa-download"></i>
                                    <span class="button-text">Excel</span>
                                </button>
                               
                            </div>
                            <div class="container-fluid mt-4" id="tbl">
                                <div class="table-responsive" style="flex: 1; overflow-y: auto; overflow-x: auto;">
                                    <div class="table-side-button left-button">
                                    </div>
                                    <table id="dataTable">
                                        <thead>
                                            <tr>
                                                <th>Pledge No</th>
                                                <th>Customer ID</th>
                                                <th>Customer Name</th>
                                                <th>Area Name</th>
                                                <th>Zonal Name</th>
                                                <th>Regional Name</th>
                                                <th>Irregularity Type</th>
                                                <th>Gross Weight</th>
                                                <th>Net Weight</th>
                                                <th>Stone Weight</th>
                                                <th>Weight Loss</th>
                                                <th>Spurious Letter Sending Date (SL1)</th>
                                                <th>Loss Amount</th>
                                                <th>GL1</th>
                                                <th>GL2</th>
                                                <th>ABH/BH</th>
                                             
                                            </tr>
                                        </thead>
                                        <tbody id="tableBody"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>


                        <div id="second_sub1" style="display: none">
                            <div class="card-header" id="chead1" style="margin: 2rem 0rem 1.5rem 0rem">
                               Purity
                            </div>
                            <div class="container-fluid mt-4">
                               
                                <button type="button" id="Excel1" class="btn btn-secondary btn-side" @* onclick="_report.downloadExcel1(this)" *@ title="Export Data">
                                    <i class="fas fa-download"></i>
                                    <span class="button-text">Excel</span>
                                </button>
                                
                            </div>
                            <div class="container-fluid mt-4" id="tbl">
                                <div class="table-responsive" style="flex: 1; overflow-y: auto; overflow-x: auto;">
                                    <div class="table-side-button left-button">
                                    </div>
                                    <table id="dataTable1">
                                        <thead>
                                            <tr>
                                                <th>Pledge</th>
                                                <th>Purity by Audit</th>
                                                <th>purity by Branch</th>
                                                <th>Items</th>
                                                
                                                
                                            </tr>
                                        </thead>
                                        <tbody id="tableBody1"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>


                <div class="card-footer text-bg-dark">
                </div>
            </div>
        </div>
    </form>

</div>




