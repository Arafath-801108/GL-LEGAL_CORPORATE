@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/legalnotice/jquery-3.6.0.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/utilitiesjs/sweetalert.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/utilitiesjs/sweetalert2@11.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/lib/aes/4.2.0-crypto-js.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/lib/aes/aes.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/advocateempanelment/empanelmentrequest.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<link href="~/css/advocateempanelment/empanelmentrequest.css" rel="stylesheet" />
<script src="~/js/advocateempanelment/requestproffessional.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<div class="container fade-in">
    <div class="page-header">
        <h1>⚖️ Advocate Empanelment Application Form</h1>
        <p>Legal Department</p>
    </div>

    <div class="form-content">
        <!-- Choice Selection -->
        <div class="choice-section">
            <div class="choice-row">
                <div class="form-group">
                    <label for="ddlchoice">Application Type: <span class="required">*</span></label>
                    <select id="ddlchoice">
                        <option value="0">-- Select Application Type --</option>
                        <option value="1">New Empanelment Registration</option>
                        <option value="2">Update Existing Details</option>
                       
                    </select>
                </div>
                <div class="form-group" id="advocateGroup" style="display:none;">
                    <label for="ddlAdvocate">Advocate Name: <span class="required">*</span></label>
                    <select id="ddlAdvocate">
                    </select>
                </div>
                <div class="form-group">
                    <label for="ddlCategory">Vertical Name: <span class="required">*</span></label>
                    <select id="ddlCategory">
                        <option value="0">--- Select ---</option>
                        <option value="1">GOLD LOAN</option>
                        <option value="2">MSME & MFI</option>
                    </select>
                </div>
                <div class="form-group">
                    <button class="btn" id="subclear">Clear</button>
                    </div>
                <div class="form-group">
                    <button class="btn exit-button" id="exit1">Exit</button>
                </div>
            </div>
        </div>

    

        <!-- Personal & Contact Details -->
        <div class="form-section" id="personalSection">
            <h2 onclick="toggleSection(this)">Personal & Contact Details</h2>
            <div class="section-content show" id="personalSection1">
                <div class="info-box">
                    <strong>Note:</strong> All fields marked with <span class="required">*</span> are mandatory. Please ensure accuracy of information provided.
                </div>

                <div class="row">
                    <div class="form-group">
                        <label>Full Name (As per Legal Documents): <span class="required">*</span></label>
                        <input type="text" id="fullName" autocomplete="off" placeholder="Enter full name" maxlength="100">
                    </div>
                    <div class="form-group">
                        <label>Father's Name / Spouse Name:<span class="required">*</span></label>
                        <input type="text" id="relativeName" autocomplete="off" placeholder="Enter father's/spouse name" maxlength="100">
                    </div>
                    <div class="form-group">
                        <label>Residence Address:<span class="required">*</span></label>
                        <input type="text" id="Residence" autocomplete="off" placeholder="Enter Residence Address" maxlength="120">
                    </div>
                    <div class="form-group">
                        <label>Office Address: <span class="required">*</span></label>
                        <input type="text" id="Ofceadrs" autocomplete="off" placeholder="Enter Office Address" maxlength="120">
                    </div>
                </div>

                <div class="row">
                    <div class="form-group">
                        <label>Date Of Birth:<span class="required">*</span></label>
                        <input type="date" id="dob" autocomplete="off" min="1900-01-01" max="3100-12-31" placeholder="Select 000 Of Birth" maxlength="50">
                    </div>
                    <div class="form-group">
                        <label>Gender:<span class="required">*</span></label>
                        <select id="gender">
                            <option>-- Select Gender --</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>State: <span class="required">*</span></label>
                        <select id="drp_state">
                           
                        </select>
                    </div>
                    <div class="form-group">
                        <label>District: <span class="required">*</span></label>
                        <select id="drp_dis">
                           
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group">
                        <label>Occupation:<span class="required">*</span></label>
                        <input type="text" autocomplete="off" id="ocupdtls" placeholder="Enter occupation" maxlength="50">
                    </div>
                    <div class="form-group">
                        <label>Nationality: <span class="required">*</span></label>
                        <input type="text" id="nation" placeholder="Nationality" autocomplete="off" maxlength="50">
                    </div>
                </div>

                <h3>Basic Information</h3>

                <div class="row">
                    <div class="form-group">
                        <label>Landline (with STD Code):<span class="required">*</span></label>
                        <input type="text" id="landline" autocomplete="off" placeholder="0XXX-XXXXXXX" maxlength="12">
                    </div>
                    <div class="form-group">
                        <label>Mobile Number: <span class="required">*</span></label>
                        <input type="text" id="mobileNumber" autocomplete="off" placeholder="+91 XXXXXXXXXXXX" maxlength="16">
                    </div>

                    <div class="form-group">
                        <label>WhatsApp Number:<span class="required">*</span></label>
                        <input type="text" id="whatsappNumber" autocomplete="off" placeholder="+91 XXXXXXXXXXXX" maxlength="16">
                    </div>

               

              
                    
                    <div class="form-group">
                        <label>Email Address: <span class="required">*</span></label>
                        <input type="email" id="emailInput" autocomplete="off" placeholder="primary@domain.com" maxlength="50">
                        <div class="error-message" id="errorMessage">Please enter a valid email address</div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group">
                        <label>PAN Number: <span class="required">*</span></label>
                        <input type="text" id="panNumber" autocomplete="off" placeholder="ABCDE1234F" maxlength="10" style="text-transform: uppercase;">
                        <span id="panError" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>Social Media Contact:<span class="required">*</span></label>
                        <input type="text" id="sociacnt" autocomplete="off" placeholder="Social Media Contact" maxlength="100">
                    </div>
                   
                </div>
                <div class="button-group">
                    <button id="btnSave" class="btn save-button">Save Section</button>


                  
                </div>
            </div>
           
        </div>

        <!-- Professional Details & Specialization -->
        <div class="form-section" id="professionalSectionWrapper">
            <h2 id="toggleProfessional">Professional Details & Specialization</h2>
            <div class="section-content" id="professionalSection">
                <h3>Legal Entity Type</h3>
                <div class="checkbox-grid">
                    <div class="form-check">
                        <input type="checkbox" id="chk1">
                        <label for="chk1" class="form-check-label">Public Limited Company</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="chk2">
                        <label for="chk2" class="form-check-label">Private Limited Company</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="chk3">
                        <label for="chk3" class="form-check-label">Individual Practitioner</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="chk4">
                        <label for="chk4" class="form-check-label">Partnership</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="chk5">
                        <label for="chk5" class="form-check-label">Partnership Firm</label>
                    </div>
                </div>

                <h3>Field of Specialization (Select All That Apply)</h3>
                <div class="checkbox-grid">
                    <div class="form-check">
                        <input type="checkbox" id="spec1">
                        <label for="spec1" class="form-check-label">Civil Law</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="spec2">
                        <label for="spec2" class="form-check-label">Criminal Law</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="spec3">
                        <label for="spec3" class="form-check-label">SARFAESI Act</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="spec4">
                        <label for="spec4" class="form-check-label">Consumer Protection</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="spec5">
                        <label for="spec5" class="form-check-label">Arbitration & Mediation</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="spec12">
                        <label for="spec12" class="form-check-label">Others (Specify Below)</label>
                    </div>
                </div>

                <div class="row-1">
                    <div class="form-group">
                        <label>If Others, Please Specify:</label>
                        <input type="text" id="otherText" autocomplete="off" placeholder="Specify other areas of specialization" maxlength="200">
                    </div>
                </div>
               
                <div class="section-divider"></div>

                <h3>Professional Credentials</h3>

                <div class="row">
                    <div class="form-group">
                        <label>Year of Inception: <span class="required">*</span></label>
                        <input type="number" id="yearOfInception" autocomplete="off" min="1900" max="2025" placeholder="YYYY" step="1">
                    </div>
                    <div class="form-group">
                        <label>Registration Number:</label>
                        <input type="text" id="regnum" placeholder="Registration number">
                    </div>
                    <div class="form-group">
                        <label>Place Of Practice:</label>
                        <input type="text" id="txtpractice" autocomplete="off" placeholder="Place Of Practice">
                    </div>
                    <div class="form-group">
                        <label>Total Years of Experience: <span class="required">*</span></label>
                        <input type="number" placeholder="Years" autocomplete="off" min="0" max="60">
                    </div>
                </div>

                <div class="row">
                    <div class="form-group">
                        <label>Grade of the Advocate: <span class="required">*</span></label>
                        <select id="ddlgrade">
                            <option value="0">-- Select --</option>
                            <option value="1">A</option>
                            <option value="2">B</option>
                            <option value="3">C</option>
                            <option value="4">D</option>

                        </select>
                    </div>
                    <div class="form-group">
                        <label>Bar Association Membership No:</label>
                        <input type="text" id="MemNo" autocomplete="off" placeholder="Membership number" maxlength="20">
                    </div>
                    <div class="form-group">
                        <label>References 1 (Name, Contact in Bank/NBFC):</label>
                        <input type="text" id="ref1" autocomplete="off" placeholder="Name, Designation" maxlength="100">
                    </div>
                    <div class="form-group">
                        <label>References 2 (Name, Contact in Bank/NBFC):</label>
                        <input type="text" id="ref2" autocomplete="off" placeholder="Name, Designation" maxlength="100">
                    </div>
                </div>
               
                <div class="row">
                    <div class="form-group">
                        <label>Number of Partners/Directors:</label>
                        <input type="number" id="part1" autocomplete="off" placeholder="Count" min="0">
                    </div>
                    <div class="form-group">
                        <label>Details of Firm Representing:</label>
                        <input type="text" id="firm" autocomplete="off" placeholder="Firm name">
                    </div>
                    <div class="form-group">
                        <label>Date Of Empaneled:</label>
                        <input type="date" id="empdate" autocomplete="off" min="1900-01-01" max="2100-12-31" placeholder="Select The Date">
                    </div>
                    <div class="form-group">
                        <label>Registered with Regulatory Body: <span class="required">*</span></label>
                        <div class="radio-inline">
                            <label><input type="radio" name="regulatory" value="yes" id="regYes"> Yes</label>
                            <label><input type="radio" name="regulatory" value="no" id="regNo"> No</label>
                        </div>
                    </div>
                </div>

                <div class="partner-details" id="partnerDetails" style="display: none;">
                    <h4>Director/Partner 1 Details</h4>
                    <div class="row">
                        <div class="form-group span-2">
                            <label>Full Name:</label>
                            <input type="text" id="fname" autocomplete="off" maxlength="100">
                        </div>
                        <div class="form-group">
                            <label>Age:</label>
                            <input type="number" id="age" autocomplete="off" min="18" max="100">
                        </div>
                        <div class="form-group">
                            <label>PAN Number:</label>
                            <input type="text" id="Pan1" maxlength="10" autocomplete="off" placeholder="ABCDE1234F" style="text-transform: uppercase;">
                            <span id="pan1Error" class="text-danger"></span>
                        </div>
                        <div class="form-group span-2">
                            <label>Address:</label>
                            <textarea rows="2" id="adrs1" autocomplete="off"></textarea>
                        </div>
                    </div>

                    <h4 style="margin-top: 20px;">Director/Partner 2 Details</h4>
                    <div class="row">
                        <div class="form-group span-2">
                            <label>Full Name:</label>
                            <input type="text" id="fname1" autocomplete="off" maxlength="100">
                        </div>
                        <div class="form-group">
                            <label>Age:</label>
                            <input type="number" id="age1" autocomplete="off" min="18" max="100">
                        </div>
                        <div class="form-group">
                            <label>PAN Number:</label> 
                            <input type="text" id="Pan2" maxlength="10" autocomplete="off" placeholder="ABCDE1234F" style="text-transform: uppercase;">
                            <span id="pan2Error" class="text-danger"></span>
                        </div>
                        <div class="form-group span-2">
                            <label>Address:</label>
                            <textarea rows="2" id="adrs2" autocomplete="off"></textarea>
                        </div>
                    </div>
                </div>
                <div class="case-number-row">
                    <div class="form-group">
                        <label>Case Amount:</label>
                        <input type="text" id="caseam" maxlength="10" autocomplete="off" placeholder="Enter the Amount">
                      
                    </div>

                    <div class="case-number-input-group">
                        <label>Case Number: <span class="required">*</span></label>
                        <input type="text"
                               id="caseNumberInput" autocomplete="off"
                               placeholder="Enter Case Number"
                               maxlength="50">
                        <span class="case-error-message" id="errorMessage"></span>
                    </div>
                    <button type="button" class="btn btn-add" id="addBtn">
                        + ADD TO TABLE
                    </button>
                </div>

                <div class="table-header">
                    <h3>Case Numbers List</h3>
                    <span class="case-count">Total: <span id="caseCount">0</span></span>
                </div>

                <table id="caseTable">
                    <thead>
                        <tr>
                            <th class="serial-column">S.No</th>
                            <th>Case Number</th>
                            <th class="action-column">Action</th>
                        </tr>
                    </thead>
                    <tbody id="caseTableBody">
                        <tr>
                            <td colspan="3" class="empty-message">
                                No case numbers added yet.<br>
                                Enter a case number above and click "Add to Table"
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div>

                </div>
                <div class="case-number-row">
                    <div class="case-number-input-group">
                        <label>Case Type: <span class="required">*</span></label>
                        <select id="ddltype">
                            <option value="0">-- Select --</option>
                            <option value="1">Closure Petition</option>
                            <option value="2">Writ Petition</option>
                            <option value="3">Execution Petition</option>
                            <option value="4">Private Complaint</option>
                            <option value="5">Custody Petition</option>
                            <option value="6">Direction Petition</option>
                            <option value="7">Consumer Case</option>
                            <option value="8">Labor Case</option>
                            <option value="9">Other Civil Case</option>
                        </select>
                        
                    </div>
                    <button type="button" class="btn btn-add" id="addtypeBtn">
                        + ADD TO TABLE
                    </button>
                   
                </div>

                <div class="table-header">
                    <h3>Case Type List</h3>
                    <span class="case-count">Total: <span id="caseTypeCount">0</span></span>
                </div>

                <table id="caseTypeTable">
                    <thead>
                        <tr>
                            <th class="serial-column">S.No</th>
                            <th>Case Type</th>
                            <th class="action-column">Action</th>
                        </tr>
                    </thead>
                    <tbody id="caseTypeTableBody">
                        <tr>
                            <td colspan="3" class="empty-message">
                                No case numbers added yet.<br>
                                Enter a case Type above and click "Add to Table"
                            </td>
                        </tr>
                    </tbody>
                </table>


                <div class="button-group">
                    <button class="btn save-button" id="profbtn">Save Section</button>

                  
                </div>
            </div>
        </div>

        <!-- Additional & Bank Details -->
        <div class="form-section">
            <h2 id="toggleadditional">Additional</h2>
            <div class="section-content" id="additional">
                <div class="row">
                    <div class="form-group">
                        <label>Number of Junior Advocates (year): <span class="required">*</span></label>
                        <input type="text" id="jnradv" maxlength="100" autocomplete="off" placeholder="Number of Junior Advocates">
                    </div>
                    <div class="form-group">
                        <label>Any Other Branches: <span class="required">*</span></label>
                        <input type="text" id="othrbranches" autocomplete="off" maxlength="100" placeholder="Any Other Branches">
                    </div>
                    <div class="form-group">
                        <label>Mode Of Communication: <span class="required">*</span></label>
                        <input type="text" maxlength="100" autocomplete="off" id="mode" placeholder="Mode Of Communication">
                    </div>
                </div>

                <h3>Bank Account Details</h3>
                <div class="row">
                    <div class="form-group">
                        <label>Account Holder Name: <span class="required">*</span></label>
                        <input type="text" id="acholder1" autocomplete="off" maxlength="100">
                    </div>
                    <div class="form-group">
                        <label>Bank Name: <span class="required">*</span></label>
                        <input type="text" id="bnknm1" autocomplete="off" maxlength="100">
                    </div>
                    <div class="form-group">
                        <label>Account Number: <span class="required">*</span></label>
                        <input type="text" id="acno1" autocomplete="off" maxlength="20">
                    </div>
                    <div class="form-group">
                        <label>IFSC Code: <span class="required">*</span></label>
                        <input type="text" id="ifsc1" autocomplete="off" maxlength="11" style="text-transform: uppercase;">
                    </div>
              </div>

                <div class="row">
                    <div class="form-group">
                        <label>Account Type: <span class="required">*</span></label>
                        <select id="actype1">
                            <option>-- Select --</option>
                            <option>Savings Account</option>
                            <option>Current Account</option>
                        </select>
                    </div>
                   
                    <div class="form-group">
                        <label>MICR Code:<span class="required">*</span></label>
                        <input type="text" id="micr1" autocomplete="off" maxlength="15">
                    </div>
                    <div class="form-group">
                        <label>Branch Code:<span class="required">*</span></label>
                        <input type="text" autocomplete="off" id="brcode1">
                    </div>
                    <div class="form-group">
                        <label>Branch Name:<span class="required">*</span></label>
                        <input type="text" autocomplete="off" id="brnm1">
                    </div>
                  
                       
                   
                </div>

               

                <div class="section-divider"></div>

                <h3>Secondary Bank Account Details</h3>
                <div class="row">
                    <div class="form-group">
                        <label>Account Holder Name:<span class="required">*</span></label>
                        <input type="text" id="acholder2" autocomplete="off" maxlength="100">
                    </div>
                    <div class="form-group">
                        <label>Bank Name: <span class="required">*</span></label>
                        <input type="text" id="bnknm2" autocomplete="off" maxlength="100">
                    </div>
                    <div class="form-group">
                        <label>Account Number:<span class="required">*</span></label>
                        <input type="text" id="acno2" autocomplete="off" maxlength="20">
                    </div>
                    <div class="form-group">
                        <label>IFSC Code:<span class="required">*</span></label>
                        <input type="text" maxlength="11" autocomplete="off" id="ifsc2" style="text-transform: uppercase;">
                    </div>
                </div>

                <div class="row">
                    <div class="form-group">
                        <label>Account Type: <span class="required">*</span></label>
                        <select id="actype2">
                            <option>-- Select --</option>
                            <option>Savings Account</option>
                            <option>Current Account</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>MICR Code:<span class="required">*</span></label>
                        <input type="text" id="micr2" autocomplete="off" maxlength="15">
                    </div>
                    <div class="form-group">
                        <label>Branch Code:<span class="required">*</span></label>
                        <input type="text" id="brcode2" autocomplete="off">
                    </div>
                    <div class="form-group">
                        <label>Branch Name:<span class="required">*</span></label>
                        <input type="text" id="brnm2" autocomplete="off">
                    </div>

                </div>

                <div class="button-group">
                    <button class="btn save-button" id="additionalsave">Save Section</button>
                   
                
                </div>
            </div>
        </div>

        <!-- Document Submission & Verification -->
        <div class="form-section">
            <h2 id="Document1">Document Submission & Verification</h2>
            <div class="section-content" id="DocumentDetails">
                <h3>In Case Of Individual</h3>
                <div class="checkbox-grid">
                    <div class="form-check">
                        <input type="checkbox" id="doc1">
                        <label for="doc1" class="form-check-label">PAN Card Copy</label>
                    </div>
               
                    <div class="form-check">
                        <input type="checkbox" id="doc3">
                        <label for="doc3" class="form-check-label">Passport Size Photograph</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="doc5">
                        <label for="doc5" class="form-check-label">Driving License/Electricity/RationCard</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="doc7">
                        <label for="doc7" class="form-check-label">Bank Statement (Last 3 Months)</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="doc8">
                        <label for="doc8" class="form-check-label">Signature Verification</label>
                    </div>
                </div>

                <div class="section-divider"></div>

                <h3>In case Of Company</h3>
                <div class="checkbox-grid">
                    <div class="form-check">
                        <input type="checkbox" id="comp1">
                        <label for="comp1" class="form-check-label">Company PAN Card</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="comp3">
                        <label for="comp3" class="form-check-label">Memorandum of Association (MOA)</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="comp5">
                        <label for="comp5" class="form-check-label">Board Resolution</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="comp6">
                        <label for="comp6" class="form-check-label">List of Directors with Details</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="comp7">
                        <label for="comp7" class="form-check-label">List of Shareholders</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="comp8">
                        <label for="comp8" class="form-check-label">Audited Balance Sheet (Last 2 Years)</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="comp10">
                        <label for="comp10" class="form-check-label">Directors' PAN & Address Proof</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="comp11">
                        <label for="comp11" class="form-check-label">Proof Of Business Place</label>
                    </div>
