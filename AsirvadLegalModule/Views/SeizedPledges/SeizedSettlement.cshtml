@{
    ViewData["Title"] = "Seized Pledge Settlement";
}
<script src="~/js/jquerymin.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
@* <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet"> *@
<link href="~/css/seizedpledges/seizedsettlement.css" rel="stylesheet" />
<script src="~/lib/aes/aes.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/lib/aes/4.2.0-crypto-js.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/seizedpledges/seizedsettlement.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/utilitiesjs/commonmethod.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Seized Pledge Settlement</h4>
                </div>
                <div class="card-body">
                    <!-- Case Details -->
                    <h5 class="section-title">Case Details</h5>
                    <div class="section-row">
                        <div class="form-group">
                            <label class="form-label">Case Category</label>
                            <select id="casecatdrp" class="form-select" @* onchange="set.SetCaseCat(this.value);clearAllFields();" *@>
                                <option value="0">Select Category</option>
                                <option value="1">STOLEN</option>
                                <option value="2">EXCEPT STOLEN</option>
                            </select>
                        </div>
                    </div>
                    <div class="section-row">
                        <div class="form-group">
                            <label class="form-label">Pledge Number</label>
                            <select id="pledg_drp" class="form-select" @* onchange="set.SetPledgeDetails(this.value); clearFieldsExceptCaseCat();" *@>
                               
                            </select>
                        </div>
                    </div>

                    <!-- Customer Details -->
                    <h5 class="section-title">Customer Details</h5>
                    <div class="section-row">
                        <div class="form-group">
                            <label class="form-label">Customer Name</label>
                            <input id="cus_name" type="text" class="form-control" readonly>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Customer ID</label>
                            <input id="cus_id" type="text" class="form-control" readonly>
                        </div>
                    </div>
                        <div class="section-row">
                        <div class="form-group">
                            <label class="form-label">Customer Address</label>
                            <input id="cus_add" type="text" class="form-control" readonly>
                        </div>
                    </div>

                    <!-- Loan Details -->
                    <h5 class="section-title">Loan Details</h5>
                    <div class="section-row">
                        <div class="form-group">
                            <label class="form-label">Loan Number </label>
                            <input id="loan_no" type="text" class="form-control" readonly>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Loan Amount </label>
                            <input id="loan_amount" type="text" class="form-control" readonly>
                        </div>
                    </div>
                    <div class="section-row">
                        <div class="form-group">
                            <label class="form-label">Gross Weight</label>
                            <input id="gross_wt" type="text" class="form-control" readonly>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Stone Weight</label>
                            <input id="stone_wt" type="text" class="form-control" readonly>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Net Weight</label>
                            <input id="net_wt" type="text" class="form-control" readonly>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Entry Date</label>
                            <input id="entry_dt" type="text" class="form-control" readonly>
                        </div>
                    </div>

                    <div class="section-row">
                        <div class="form-group">
                            <label class="form-label">Branch Name</label>
                            <input id="br_name" type="text" class="form-control" readonly>
                        </div>
                         <div class="form-group">
                            <label class="form-label">Type of Irregularity</label>
                            <input id="irr_type" type="text" class="form-control" readonly>
                        </div>
                    </div>

                    <div class="section-row">
                        <div class="form-group">
                            <label class="form-label">Paperless Approval ID</label>
                            <input id="paper_id" type="text" class="form-control" readonly>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Manual Approval ID</label>
                            <input id="man_id" type="text" class="form-control" readonly>
                        </div>
                    </div>

                     

              
                   
                    <!-- Document Links -->
                    <h5 class="section-title">Documents</h5>
                    <div class="document-links">
                        <a href="#" id="viewLO9" class="btn btn-link">View LO9/LO5</a>
                        <a href="#" id="viewFIR" class="btn btn-link">View FIR</a>
                        <a href="#" id="view91" class="btn btn-link">View 91-Notice</a>
                        <a href="#" id="viewPawn" class="btn btn-link">View Pawn Ticket</a>
                        <a href="#" id="viewDpn" class="btn btn-link">View DPN</a>
                        <a href="#" id="viewKYC" class="btn btn-link">View KYC</a>
                        <a href="#" id="viewSeiz" class="btn btn-link">View Seizure Mahazar</a>
                        <a href="#" id="viewCon" class="btn btn-link">View Confession Statement</a>
                        <a href="#" id="viewRec" class="btn btn-link">View Cheating Complaint Receipt</a>
                        <a href="#" id="viewDra" class="btn btn-link">View Cheating Complaint Signed Draft</a>

                    </div>
                    <!-- Settlement Details -->
                    <h5 class="section-title">Settlement Details</h5>
                    <div class="section-row">
                        <div class="form-group">
                            <label class="form-label">Settlement Amount</label>
                            <div class="input-group">
                                <button type="button" id="set_btn" class="btn btn-primary ms-2" style="font-weight: bold;" @* onclick="set.SetAmountFetch(this.value);" *@>Calculate Settlement Amount</button>
                                <input type="text" id="set_amt" class="form-control" readonly style="width: 324px;"  />
                            </div>
                        </div>
                    </div>
                    <!-- Comments Section -->
                    <h5 class="section-title">Remarks</h5>
                    <div class="form-group">
                        <label class="form-label">Add Remarks</label>
                        <textarea id="set_rmk" class="form-control" rows="4" maxlength="200" placeholder="Enter your remarks here"></textarea>
                    </div>

                    <!-- Action Buttons -->
                    <div class="text-center mt-5">
                        <button type="button" id="btnsubmit" class="btn btn-primary me-3">Confirm</button>
                        <button type="button" id="btnreject" class="btn btn-outline-secondary me-3">Reject</button>
                        <button type="button" id="btnexit" class="btn btn-outline-secondary">Exit</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="documentModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close">&times;</span>

        <iframe id="docViewer" style="width:100%; height:500px; border:none;"></iframe>
        <img id="imgViewer" style="display:none; max-width:100%; height:auto;" alt="Document View" />

    </div>
</div>