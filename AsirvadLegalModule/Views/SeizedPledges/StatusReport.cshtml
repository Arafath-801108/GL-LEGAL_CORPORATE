@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/seizedpledges/statusreport.css" rel="stylesheet" />
<script src="~/js/jquerymin.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/popper.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/lib/sweet-alert/sweet-alert2.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/lib/aes/4.2.0-crypto-js.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/lib/aes/aes.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/seizedpledges/statusreport.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/alertutils.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>

<script src="~/js/utilitiesjs/commonmethod.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/legalnotice/xlsx.full.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<script src="~/js/legalnotice/jquery.datatables.min.js" nonce="5d67de6751aa4e158c33dfd828fc144b"></script>
<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Seized Gold Summary Report</h3>
        </div>
        <div class="card-body">
            <div class="section-row">
                <div class="form-group">
                    <label for="fmDate" class="form-label">From Date:</label>
                    <input type="date" id="fmDate" name="fmDate" class="form-control" placeholder="Select start date"  />
                </div>
                <div class="form-group">
                    <label for="toDate" class="form-label">To Date:</label>
                    <input type="date" id="toDate" name="toDate" class="form-control" placeholder="Select end date"  />
                </div>
                <div class="form-group">
                    <label for="category" class="form-label">Select Category:</label>
                    <select id="category" name="category" class="form-control">
                        <option value="-1">-- Select Category --</option>
                        <option value="1">Stolen Gold Report</option>
                        <option value="2">Except Stolen Gold Report</option>

                    </select>
                </div>
            </div>

           
          
            <div class="text-center mt-5">
                <button id="generateReport" class="btn btn-primary">Generate Report</button>
                 <button id="exitButton" class="btn btn-secondary">Exit</button>
            </div>
            <div id="reportResult" style="display:none;">
                <h5 class="section-title">Report Results</h5>
                <div class="report-table-container">
                    <table id="dataTable1" class="report-table">
                        <thead>
                            <tr>
                                <th>Region</th>
                                <th>Area</th>
                                <th>Branch Name</th>
                                <th>Branch ID</th>
                                <th>State Name</th>
                                <th>Zonal Name</th>
                                <th>Customer ID</th>
                                <th>Customer Name</th>
                                <th>Pledge No</th>
                                <th>Seizure Mahazar</th>
                                <th>FIR No</th>
                                <th>FIR Filed Date</th>
                                <th>Court Name</th>
                                <th>Police Station Name</th>
                                <th>Irregularity Type</th>
                                <th>Seizure Date</th>
                                <th>Court No</th>
                                <th>Pledge Status</th>
                                <th>Pledge Date</th>
                                <th>Pledge Amount</th>
                                <th>Loan Balance</th>
                                <th>Gross Wt</th>
                                <th>Stone Wt</th>
                                <th>Net Wt</th>
                                <th>Theft Updated Date</th>
                                <th>Updated Authority</th>
                                <th>LO9 Updated Date</th>
                                <th>LO9 Authority</th>
                                <th>Classified Date</th>
                                <th>Classified Authority</th>
                                <th>RM Updated Date</th>
                                <th>RM Authority</th>
                                <th>LM Updated  Date</th>
                                <th>LM Authority</th>
                                <th>Settled Date</th>
                                <th>Settled Authority</th>
                                <th>Status</th>
                                <th>Classification</th>
                                <th>Pledge Zone</th>
                                <th>Paperless Approval ID</th>
                                <th>Manual Approval ID</th>
                            </tr>
                        </thead>
                        <tbody id="reportTableBody"></tbody>
                    </table>
                </div>
            </div>
            <div id="reportResult2" style="display:none;">
                <h5 class="section-title">Report Results</h5>
                <div class="report-table-container">
                    <table id="dataTable2" class="report-table">
                        <thead>
                            <tr>
                                <th>Branch ID</th>
                                <th>Branch Name</th>
                                <th>Area Name</th>
                                <th>Region Name</th>
                                <th>Zonal Name</th>
                                <th>Pledge Number</th>
                                <th>Customer ID</th>
                                <th>Customer Name</th>
                                <th>Gross Weight</th>
                                <th>Net Weight</th>
                                <th>Seizure Date</th>
                                <th>Pledge Status</th>
                                <th>Updated Date</th>
                                <th>Updated Authority</th>
                                <th>LO5 Updated Date</th>
                                <th>LO5 Authority</th>
                                <th>Classified Date</th>
                                <th>Classified Authority</th>
                                <th>RM Authority</th>
                                <th>RM Updated Date</th>
                                <th>LM Authority</th>
                                <th>LM Updated  Date</th>
                                <th>Approver</th>
                                <th>Settled Date</th>
                                <th>Pledge Value</th>
                                <th>Police Station</th>
                                <th>FIR Number</th>
                                <th>FIR Date</th>
                                <th>Seizure Mahasser</th>
                                <th>Irregularity Status</th>
                                <th>Pledge Zone</th>
                                <th>Settled Amount</th>
                            </tr>
                        </thead>
                        <tbody id="reportTableBody2"></tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>